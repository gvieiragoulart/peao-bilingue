# Optional: the app is configured on screen, and secrets go to Windows Credential
# Manager. This file is a fallback for the command line. Copy it to .env.

# Which adapters to use, by their registered name (`uv run peao adapters` lists them).
# Lists in JSON format.
ENABLED_SOURCES=["vanhack"]
# The LLM preselected on the jobs screen (analysis is requested job by job).
ANALYSIS_LLM=anthropic
# Notices after the scheduled collection. Only turn on channels already filled in,
# e.g. NOTIFIERS=["email","whatsapp"]
NOTIFIERS=[]

# VanHack
# Login is passwordless and manual (magic link / Google / LinkedIn): there are no
# credentials here. The session comes from `uv run peao login` -> data/state.json.
VANHACK_LOGIN_URL=https://auth.vanhack.com
VANHACK_JOBS_URL=https://app.vanhack.com/jobs
VANHACK_PROFILE_URL=https://app.vanhack.com/profile
HEADLESS=true
BROWSER_CHANNEL=chrome
MAX_LISTING_SCROLLS=15
MAX_DETAILS_PER_RUN=15

# Himalayas: only jobs open to this country (ISO code) or worldwide; empty = no filter.
HIMALAYAS_COUNTRY=BR

TIMEZONE=America/Sao_Paulo

# LLM providers (fill in only the ones you use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Ollama: local and free. OLLAMA_CONTEXT keeps it from cutting the prompt silently.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT=8192
# OpenAI and Gemini have no default model: their catalogs change.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Notes that complement the profile in every analysis
PROFILE_NOTES_PATH=profile_notes.md

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# WhatsApp (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+55XXXXXXXXXXX
