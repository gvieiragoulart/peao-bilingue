# Quais adapters usar, pelo nome registrado (`uv run peao adaptadores` lista).
# Listas em formato JSON.
FONTES_HABILITADAS=["vanhack"]
LLM_ANALISE=anthropic
# Opcional: LLM barato que dá uma nota rápida antes da análise completa.
# Ex.: LLM_TRIAGEM=ollama -> só vagas com nota >= LIMIAR_TRIAGEM gastam crédito.
LLM_TRIAGEM=
LIMIAR_TRIAGEM=60
NOTIFICADORES=["email","whatsapp"]

# VanHack
# Login é passwordless e manual (magic link / Google / LinkedIn): não há
# credenciais aqui. A sessão vem de `uv run peao login` -> data/state.json.
VANHACK_LOGIN_URL=https://auth.vanhack.com
VANHACK_JOBS_URL=https://app.vanhack.com/jobs
VANHACK_PROFILE_URL=https://app.vanhack.com/profile
HEADLESS=true
BROWSER_CHANNEL=chrome
MAX_LISTING_SCROLLS=15
MAX_DETAILS_PER_RUN=15

TIMEZONE=America/Sao_Paulo

# Provedores de LLM (preencha só os que for usar)
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-sonnet-5-5
# Ollama: local e grátis. OLLAMA_CONTEXTO evita que ele corte o prompt em silêncio.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELO=qwen3:8b
OLLAMA_CONTEXTO=8192
# OpenAI e Gemini não têm modelo padrão: o catálogo deles muda.
OPENAI_API_KEY=
OPENAI_MODELO=
GEMINI_API_KEY=
GEMINI_MODELO=

# Análise
PROFILE_NOTES_PATH=profile_notes.md
REANALYZE_ON_PROFILE_CHANGE=true
MAX_REANALYSES_ON_CHANGE=10
MAX_ANALYSES_PER_RUN=10

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# WhatsApp (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+55XXXXXXXXXXX

DRY_RUN=false
